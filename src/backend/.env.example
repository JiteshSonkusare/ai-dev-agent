# Environment — development | production
ENV=development
APP_BASE_URL=http://localhost:8000

# Database — Azure SQL (MS SQL)
DATABASE_URL=mssql+aioodbc://user:password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Encryption key for stored credentials (Fernet) — leave empty to auto-generate (dev only)
ENCRYPTION_KEY=

# Session
SESSION_EXPIRE_HOURS=24

# Agent workspace path
# Local: /tmp/agent-workspace
# VM: C:\agent-workspace
WORKSPACE_BASE_PATH=/tmp/agent-workspace
