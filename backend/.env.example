# Database — SQLite for local dev, MS SQL for production
# SQLite: sqlite+aiosqlite:///./cc_automation.db
# MS SQL: mssql+aioodbc://sqladmin:Password@server.database.windows.net/dbname?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=sqlite+aiosqlite:///./cc_automation.db

# Encryption key for stored credentials (Fernet) — leave empty to auto-generate (dev only)
ENCRYPTION_KEY=

# Session
SESSION_EXPIRE_HOURS=24

# Agent workspace path
WORKSPACE_BASE_PATH=/tmp/agent-workspace
